#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=95
STOP=10
USE_PROCD=1

start_service() {
	local activity_always
	config_load unifi
	config_get_bool activity_always theme activity_always 1
	[ "$activity_always" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/unifi/activity.uc
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger unifi
}

reload_service() {
	# procd preserves a running instance when its command is unchanged.
	start
}
